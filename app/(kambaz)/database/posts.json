[
  {
    "_id": "P101",
    "course": "RS101",
    "type": "QUESTION",
    "summary": "How do I compute specific impulse from thrust and mass flow rate?",
    "details": "<p>HW1 problem 3 gives the thrust and the propellant mass flow rate. Is Isp = F / (m · g0) the right formula, and which units should I use?</p>",
    "folders": [
      "RS101-hw1"
    ],
    "author": "123",
    "visibility": "CLASS",
    "visibleTo": [],
    "createdAt": "2026-11-19T10:24:00",
    "views": 3,
    "viewedBy": [
      "123",
      "678"
    ],
    "readBy": [
      "123",
      "678"
    ],
    "studentAnswers": [],
    "instructorAnswers": [
      {
        "_id": "A101",
        "author": "678",
        "createdAt": "2026-11-19T11:02:00",
        "content": "<p>Yes. Use Isp = F / (m · g0) with F in newtons, m in kg/s and g0 = 9.80665 m/s². The result is in seconds.</p>"
      }
    ],
    "discussions": [
      {
        "_id": "D101",
        "author": "234",
        "createdAt": "2026-11-19T11:30:00",
        "content": "<p>Does g0 change if the rocket is in orbit?</p>",
        "resolved": false,
        "replies": [
          {
            "_id": "R101",
            "author": "123",
            "createdAt": "2026-11-19T11:41:00",
            "content": "<p>I think g0 is just a constant used for the units?</p>"
          },
          {
            "_id": "R102",
            "author": "678",
            "createdAt": "2026-11-19T12:05:00",
            "content": "<p>Correct. g0 is standard gravity at sea level; it stays the same no matter where the rocket is.</p>"
          }
        ]
      }
    ]
  },
