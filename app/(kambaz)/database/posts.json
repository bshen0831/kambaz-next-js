  {
    "_id": "P103",
    "course": "RS101",
    "type": "QUESTION",
    "summary": "Why does the nozzle expansion ratio matter at sea level?",
    "details": "<p>Why would a nozzle optimized for vacuum perform worse at sea level? More expansion should always mean more thrust, right?</p>",
    "folders": [
      "RS101-hw2"
    ],
    "author": "234",
    "visibility": "CLASS",
    "visibleTo": [],
    "createdAt": "2026-11-18T16:15:00",
    "views": 8,
    "viewedBy": [
      "234",
      "345",
      "123"
    ],
    "readBy": [
      "234",
      "345",
      "123"
    ],
    "studentAnswers": [
      {
        "_id": "A102",
        "author": "345",
        "createdAt": "2026-11-18T18:20:00",
        "content": "<p>At sea level an over-expanded nozzle drops the exit pressure below the outside air pressure, so the pressure-thrust term becomes negative.</p>"
      }
    ],
    "instructorAnswers": [],
    "discussions": [
      {
        "_id": "D102",
        "author": "234",
        "createdAt": "2026-11-18T19:00:00",
        "content": "<p>Thanks, the pressure-thrust term was what I was missing.</p>",
        "resolved": true,
        "replies": []
      }
    ]
  },
